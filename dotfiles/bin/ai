#!/usr/bin/env bash
# ==============================================================================
# msUI AI CLI & Interactive Launcher
# ==============================================================================
# Universal entrypoint for:
#   1. Subcommands: ai start | ai stop | ai toggle | ai status | ai chat
#   2. Piped queries: cat file | ai "Explain this"
#   3. Direct prompts: ai "Generate SVG circle"
#   4. Interactive terminal chat: ai
# ==============================================================================

set -uo pipefail

SCRIPT_DIR="${HOME}/.config/hypr/scripts/ai"

case "${1:-}" in
    start|stop|restart|status|models|list|delete|rm|pull|download)
        exec msui ai "$@"
        ;;
    toggle)
        exec "${SCRIPT_DIR}/ai-control.sh" toggle
        ;;
    window)
        exec "${SCRIPT_DIR}/ai-control.sh" chat
        ;;
    chat)
        if [[ $# -gt 1 ]]; then
            shift
            exec msui ai chat "$@"
        elif [[ ! -t 0 ]]; then
            exec msui ai chat
        else
            exec "${SCRIPT_DIR}/ai-control.sh" chat
        fi
        ;;
    --help|-h)
        exec msui ai --help
        ;;
    *)
        # If no arguments and stdin is interactive terminal, open floating chat
        if [[ $# -eq 0 && -t 0 ]]; then
            exec "${SCRIPT_DIR}/ai-control.sh" chat
        else
            # Piped input or direct prompt
            exec msui ai chat "$@"
        fi
        ;;
esac
