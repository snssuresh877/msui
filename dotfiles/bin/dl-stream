#!/usr/bin/env bash
# =============================================================================
# Fast HLS / m3u8 Stream Downloader using yt-dlp & ffmpeg
# Supports direct URL arguments or automatic clipboard detection (Wayland / wl-paste)
# Tuned for Arch Linux / Hyprland & The Stream Detector Firefox Extension
# =============================================================================

set -eo pipefail

DOWNLOAD_DIR="${HOME}/Downloads"
mkdir -p "$DOWNLOAD_DIR"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"

log_info() { echo -e "${C_BLUE}ℹ${C_RESET} $*"; }
log_ok()   { echo -e "${C_GREEN}✓${C_RESET} $*"; }
log_warn() { echo -e "${C_YELLOW}⚠${C_RESET} $*"; }
log_err()  { echo -e "${C_RED}✗${C_RESET} $*"; }

# -----------------------------------------------------------------------------
# Dependency Checklist & Verification
# -----------------------------------------------------------------------------
check_dependencies() {
    local verbose="${1:-0}"
    local missing_core=0
    local missing_opt=0

    if [[ "$verbose" -eq 1 ]]; then
        echo -e "${C_BOLD}${C_CYAN}=== Dependency & System Checklist ===${C_RESET}"
    fi

    # Check Core: yt-dlp
    if command -v yt-dlp >/dev/null 2>&1; then
        local ver
        ver=$(yt-dlp --version 2>/dev/null || echo "installed")
        [[ "$verbose" -eq 1 ]] && log_ok "yt-dlp:       ${C_BOLD}${ver}${C_RESET} (${C_GRAY}$(command -v yt-dlp)${C_RESET})"
    else
        log_err "yt-dlp:       NOT FOUND (Required for stream extraction)"
        missing_core=1
    fi

    # Check Core: ffmpeg
    if command -v ffmpeg >/dev/null 2>&1; then
        [[ "$verbose" -eq 1 ]] && log_ok "ffmpeg:       Installed (${C_GRAY}$(command -v ffmpeg)${C_RESET})"
    else
        log_err "ffmpeg:       NOT FOUND (Required for HLS chunk merging & conversion)"
        missing_core=1
    fi

    # Check Wayland Clipboard: wl-paste
    if command -v wl-paste >/dev/null 2>&1; then
        [[ "$verbose" -eq 1 ]] && log_ok "wl-clipboard: Installed (${C_GRAY}wl-paste active for auto-clipboard${C_RESET})"
    else
        [[ "$verbose" -eq 1 ]] && log_warn "wl-clipboard: NOT FOUND (Auto-clipboard mode requires wl-paste)"
        missing_opt=1
    fi

    # Check Notifications: notify-send
    if command -v notify-send >/dev/null 2>&1; then
        [[ "$verbose" -eq 1 ]] && log_ok "libnotify:    Installed (${C_GRAY}notify-send active for desktop alerts${C_RESET})"
    else
        [[ "$verbose" -eq 1 ]] && log_warn "libnotify:    NOT FOUND (Optional: desktop notifications)"
        missing_opt=1
    fi

    # Check Optional Accelerator: aria2c
    if command -v aria2c >/dev/null 2>&1; then
        [[ "$verbose" -eq 1 ]] && log_ok "aria2:        Installed (${C_GRAY}high-speed multi-connection accelerator${C_RESET})"
    else
        [[ "$verbose" -eq 1 ]] && echo -e "  ${C_GRAY}• aria2:        Not installed (Optional: multi-connection booster)${C_RESET}"
    fi

    if [[ "$missing_core" -gt 0 ]]; then
        echo -e "\n${C_RED}${C_BOLD}Missing core dependencies!${C_RESET} Please install them using pacman:"
        echo -e "  ${C_CYAN}sudo pacman -S yt-dlp ffmpeg wl-clipboard libnotify${C_RESET}\n"
        return 1
    fi

    if [[ "$verbose" -eq 1 ]]; then
        echo -e "${C_GREEN}${C_BOLD}All core requirements are satisfied!${C_RESET}\n"
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Help Screen & Command Reference
# -----------------------------------------------------------------------------
show_help() {
    echo -e "${C_BOLD}${C_CYAN}dl-stream - Fast HLS (.m3u8) & Video Stream Downloader${C_RESET}
Tuned for Arch Linux / Hyprland & The Stream Detector

${C_BOLD}USAGE:${C_RESET}
    ${C_GREEN}dl-stream${C_RESET}                         Download stream URL directly from Wayland clipboard
    ${C_GREEN}dl-stream <url>${C_RESET}                   Download specified stream URL
    ${C_GREEN}dl-stream <url> <filename>${C_RESET}        Download stream with a custom filename
    ${C_GREEN}dl-stream --audio [url]${C_RESET}           Extract and save as high-quality MP3 audio
    ${C_GREEN}dl-stream --check${C_RESET}                 Run full dependency and system checklist
    ${C_GREEN}dl-stream --manual${C_RESET}                Show full yt-dlp cheat sheet & manual
    ${C_GREEN}dl-stream --help${C_RESET}                  Show this help reference

${C_BOLD}HOW TO USE WITH THE STREAM DETECTOR (FIREFOX):${C_RESET}
    1. Open any video in Firefox and press Play for 2 seconds.
    2. Click ${C_BOLD}The Stream Detector${C_RESET} icon on the top toolbar.
    3. Click the ${C_BOLD}Copy${C_RESET} button next to the detected stream (.m3u8 / .mpd).
    4. In terminal, simply run:
         ${C_CYAN}dl-stream${C_RESET}
       ${C_GRAY}(It automatically grabs the copied stream from clipboard and downloads it!)${C_RESET}

${C_BOLD}COMMAND EXAMPLES:${C_RESET}
    # Download automatically from clipboard:
    dl-stream

    # Download with a custom name:
    dl-stream \"https://example.com/stream/master.m3u8\" \"lecture_01.mp4\"

    # Download audio only:
    dl-stream -a \"https://example.com/stream/master.m3u8\"

    # View full practical manual:
    dl-stream --manual

    # Verify dependencies:
    dl-stream --check

${C_BOLD}DESTINATION:${C_RESET}
    All downloads are saved automatically into: ${C_BOLD}${DOWNLOAD_DIR}${C_RESET}"
}

show_manual() {
    local script_dir
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    local manual_file="${script_dir}/../docs/yt-dlp-manual.md"
    if [[ -f "$manual_file" ]]; then
        if command -v bat >/dev/null 2>&1; then
            bat --style=plain --language=markdown "$manual_file"
        elif command -v glow >/dev/null 2>&1; then
            glow "$manual_file"
        else
            cat "$manual_file"
        fi
    else
        echo -e "${C_RED}Manual file not found at: ${manual_file}${C_RESET}"
    fi
}

# -----------------------------------------------------------------------------
# Main Execution Logic
# -----------------------------------------------------------------------------
# Handle flags
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    -m|--manual|manual)
        show_manual
        exit 0
        ;;
    -c|--check|check)
        check_dependencies 1
        exit 0
        ;;
esac

# Pre-flight core requirement check (silent unless missing)
check_dependencies 0

AUDIO_MODE=0
URL=""
OUT_NAME=""

# Parse flags or positional args
if [[ "${1:-}" == "-a" || "${1:-}" == "--audio" ]]; then
    AUDIO_MODE=1
    shift
fi

URL="${1:-}"
OUT_NAME="${2:-}"

# Auto-detect from Wayland clipboard if no URL passed
if [[ -z "$URL" ]]; then
    if command -v wl-paste >/dev/null 2>&1; then
        CLIP="$(wl-paste 2>/dev/null || true)"
        if [[ "$CLIP" =~ ^https?:// ]] || [[ "$CLIP" =~ yt-dlp ]]; then
            URL="$CLIP"
            echo -e "${C_CYAN}ℹ Detected stream in clipboard:${C_RESET} ${URL:0:70}..."
        fi
    fi
fi

# If still empty, display instructions and exit
if [[ -z "$URL" ]]; then
    log_warn "No stream URL found in arguments or clipboard."
    echo -e "Copy a stream from ${C_BOLD}The Stream Detector${C_RESET} in Firefox, or provide a URL.\n"
    show_help
    exit 1
fi

cd "$DOWNLOAD_DIR"

# Case A: User copied the full yt-dlp command from The Stream Detector
# (e.g. yt-dlp "https://..." --referer "..." --user-agent "...")
if [[ "$URL" =~ ^yt-dlp[[:space:]] ]]; then
    echo -e "${C_BOLD}${C_GREEN}Executing stream download command in ${DOWNLOAD_DIR}...${C_RESET}"
    eval "$URL"
    log_ok "Stream download complete! Saved in: ${DOWNLOAD_DIR}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i video-x-generic "Stream Download Complete" "Saved to ~/Downloads"
    fi
    exit 0
fi

# Case B: Download URL with multi-connection acceleration
echo -e "${C_BOLD}${C_CYAN}Starting stream download (8 parallel connections)...${C_RESET}"
echo -e "Destination: ${C_BOLD}${DOWNLOAD_DIR}${C_RESET}\n"

YTDLP_ARGS=(
    "-N" "8"
    "--concurrent-fragments" "8"
    "--progress"
    "--no-mtime"
)

# Use aria2c if available for extra speed
if command -v aria2c >/dev/null 2>&1; then
    YTDLP_ARGS+=("--downloader" "aria2c" "--downloader-args" "aria2c:-s 8 -x 8 -k 1M -j 8")
fi

if [[ "$AUDIO_MODE" -eq 1 ]]; then
    echo -e "${C_YELLOW}Mode: Extracting audio (MP3 320k)${C_RESET}"
    YTDLP_ARGS+=(
        "-x"
        "--audio-format" "mp3"
        "--audio-quality" "0"
    )
fi

if [[ -n "$OUT_NAME" ]]; then
    # Ensure correct extension if omitted
    if [[ "$OUT_NAME" != *.* ]]; then
        if [[ "$AUDIO_MODE" -eq 1 ]]; then
            OUT_NAME="${OUT_NAME}.mp3"
        else
            OUT_NAME="${OUT_NAME}.mp4"
        fi
    fi
    YTDLP_ARGS+=("-o" "$OUT_NAME")
else
    YTDLP_ARGS+=("-o" "%(title)s_%(id)s.%(ext)s")
fi

# Execute download
yt-dlp "${YTDLP_ARGS[@]}" "$URL"

echo ""
log_ok "Download finished! File saved in: ${DOWNLOAD_DIR}"
if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal -i video-x-generic "Download Complete" "Saved to ~/Downloads"
fi
