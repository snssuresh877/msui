#!/usr/bin/env bash
# =============================================================================
# vconv - Simple Video & Audio Converter Wrapper using FFmpeg
# Supports instant remuxing, resolution scaling, compression, and audio extraction
# Tuned for Arch Linux / AMD VA-API Hardware Acceleration
# =============================================================================

set -eo pipefail

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"

log_info() { echo -e "${C_BLUE}ℹ${C_RESET} $*"; }
log_ok()   { echo -e "${C_GREEN}✓${C_RESET} $*"; }
log_warn() { echo -e "${C_YELLOW}⚠${C_RESET} $*"; }
log_err()  { echo -e "${C_RED}✗${C_RESET} $*"; }

show_help() {
    echo -e "${C_BOLD}${C_CYAN}vconv - Simple Video & Audio Converter (FFmpeg Wrapper)${C_RESET}

${C_BOLD}USAGE:${C_RESET}
    ${C_GREEN}vconv <input_file> <target_format_or_resolution>${C_RESET} [output_file]

${C_BOLD}RESOLUTION TARGETS:${C_RESET}
    ${C_CYAN}720p${C_RESET}      Scale video to 720p HD (${C_GRAY}scale=-2:720, crf 23${C_RESET})
    ${C_CYAN}1080p${C_RESET}     Scale video to 1080p Full HD (${C_GRAY}scale=-2:1080, crf 22${C_RESET})
    ${C_CYAN}480p${C_RESET}      Scale video to 480p SD (${C_GRAY}small file size${C_RESET})

${C_BOLD}CONTAINER / FORMAT TARGETS:${C_RESET}
    ${C_CYAN}mp4${C_RESET}       Convert/Remux to MP4 (${C_GRAY}uses instant stream copy if compatible${C_RESET})
    ${C_CYAN}mkv${C_RESET}       Convert/Remux to MKV
    ${C_CYAN}webm${C_RESET}      Convert to WebM VP9/Opus
    ${C_CYAN}mp3${C_RESET}       Extract high-quality 320k MP3 audio
    ${C_CYAN}gif${C_RESET}       Generate high-quality animated GIF with palette
    ${C_CYAN}compress${C_RESET}  Compress video using balanced CRF 26 (${C_GRAY}saves 60-80% space${C_RESET})

${C_BOLD}OPTIONS:${C_RESET}
    ${C_GREEN}vconv -m, --manual${C_RESET}    Open the complete FFmpeg practical manual
    ${C_GREEN}vconv -h, --help${C_RESET}      Show this help message

${C_BOLD}EXAMPLES:${C_RESET}
    # Instant container change (zero re-encoding loss, takes 1s):
    vconv movie.mkv mp4

    # Scale to 720p:
    vconv video.mp4 720p

    # Extract MP3 audio:
    vconv lecture.mp4 mp3

    # Compress file size:
    vconv raw_recording.mp4 compress"
}

show_manual() {
    local script_dir
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    local manual_file="${script_dir}/../docs/ffmpeg-manual.md"
    if [[ -f "$manual_file" ]]; then
        if command -v bat >/dev/null 2>&1; then
            bat --style=plain --language=markdown "$manual_file"
        elif command -v glow >/dev/null 2>&1; then
            glow "$manual_file"
        else
            cat "$manual_file"
        fi
    else
        echo -e "${C_RED}Manual not found at: ${manual_file}${C_RESET}"
    fi
}

# Handle flags
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    -m|--manual|manual)
        show_manual
        exit 0
        ;;
esac

INPUT="${1:-}"
TARGET="${2:-}"
OUTPUT="${3:-}"

if [[ -z "$INPUT" || -z "$TARGET" ]]; then
    log_warn "Missing input file or target action."
    show_help
    exit 1
fi

if [[ ! -f "$INPUT" ]]; then
    log_err "Input file not found: $INPUT"
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    log_err "ffmpeg is not installed! Run: sudo pacman -S ffmpeg"
    exit 1
fi

BASE_NAME="${INPUT%.*}"
EXT="${INPUT##*.}"

case "$TARGET" in
    # Resolution downscaling
    720p|720)
        OUT="${OUTPUT:-${BASE_NAME}_720p.mp4}"
        echo -e "${C_CYAN}Scaling to 720p HD -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -vf "scale=-2:720" -c:v libx264 -crf 23 -preset medium -c:a copy "$OUT"
        ;;
    1080p|1080)
        OUT="${OUTPUT:-${BASE_NAME}_1080p.mp4}"
        echo -e "${C_CYAN}Scaling to 1080p Full HD -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -vf "scale=-2:1080" -c:v libx264 -crf 22 -preset medium -c:a copy "$OUT"
        ;;
    480p|480)
        OUT="${OUTPUT:-${BASE_NAME}_480p.mp4}"
        echo -e "${C_CYAN}Scaling to 480p SD -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -vf "scale=-2:480" -c:v libx264 -crf 24 -preset medium -c:a aac -b:a 128k "$OUT"
        ;;

    # Format / Container changing
    mp4)
        OUT="${OUTPUT:-${BASE_NAME}.mp4}"
        if [[ "$OUT" == "$INPUT" ]]; then OUT="${BASE_NAME}_converted.mp4"; fi
        echo -e "${C_CYAN}Attempting instant stream remux to MP4...${C_RESET}"
        if ! ffmpeg -i "$INPUT" -c copy "$OUT" 2>/dev/null; then
            echo -e "${C_YELLOW}Stream copy incompatible, re-encoding to H.264/AAC...${C_RESET}"
            ffmpeg -i "$INPUT" -c:v libx264 -crf 22 -c:a aac "$OUT"
        fi
        ;;
    mkv)
        OUT="${OUTPUT:-${BASE_NAME}.mkv}"
        if [[ "$OUT" == "$INPUT" ]]; then OUT="${BASE_NAME}_converted.mkv"; fi
        echo -e "${C_CYAN}Remuxing to MKV -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -c copy "$OUT"
        ;;
    webm)
        OUT="${OUTPUT:-${BASE_NAME}.webm}"
        echo -e "${C_CYAN}Converting to WebM (VP9/Opus) -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -c:v libvpx-vp9 -crf 30 -b:v 0 -c:a libopus "$OUT"
        ;;

    # Audio extraction
    mp3)
        OUT="${OUTPUT:-${BASE_NAME}.mp3}"
        echo -e "${C_CYAN}Extracting high-quality 320k MP3 audio -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -vn -q:a 0 "$OUT"
        ;;

    # Compression
    compress|shrink)
        OUT="${OUTPUT:-${BASE_NAME}_compressed.mp4}"
        echo -e "${C_CYAN}Compressing video (CRF 26) -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -c:v libx264 -crf 26 -preset slow -c:a aac -b:a 128k "$OUT"
        ;;

    # High quality GIF
    gif)
        OUT="${OUTPUT:-${BASE_NAME}.gif}"
        echo -e "${C_CYAN}Generating high-quality GIF with color palette -> ${OUT}...${C_RESET}"
        ffmpeg -i "$INPUT" -filter_complex "[0:v] fps=15,scale=480:-1:flags=lanczos,split [a][b];[a] palettegen [p];[b][p] paletteuse" "$OUT"
        ;;

    *)
        log_err "Unknown target '$TARGET'."
        show_help
        exit 1
        ;;
esac

echo ""
log_ok "Finished successfully: ${OUT}"
if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal -i video-x-generic "Conversion Complete" "Saved to $(basename "$OUT")"
fi
