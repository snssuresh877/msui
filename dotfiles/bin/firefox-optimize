#!/usr/bin/env bash
# =============================================================================
# Firefox Optimizer & Maintenance Script
# Tuned for Arch Linux / Hyprland / Wayland (AMD Radeon / VA-API)
# =============================================================================

set -eo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
TEMPLATE_USER_JS="${DOTFILES_DIR}/firefox/user.js"
FIREFOX_DIR="${HOME}/.mozilla/firefox"
PROFILES_INI="${FIREFOX_DIR}/profiles.ini"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"

log_info() { echo -e "${C_BLUE}ℹ${C_RESET} $*"; }
log_ok() { echo -e "${C_GREEN}✓${C_RESET} $*"; }
log_warn() { echo -e "${C_YELLOW}⚠${C_RESET} $*"; }
log_err() { echo -e "${C_RED}✗${C_RESET} $*"; }
log_header() {
    echo -e "\n${C_BOLD}${C_CYAN}=== $* ===${C_RESET}"
}

# Ensure Firefox profile directory exists
if [[ ! -d "$FIREFOX_DIR" ]] || [[ ! -f "$PROFILES_INI" ]]; then
    log_err "Firefox directory or profiles.ini not found at: ${FIREFOX_DIR}"
    exit 1
fi

# Function: Detect all profiles (returns list of "Name:Path")
get_profiles() {
    local current_name=""
    local current_path=""
    local is_relative=1

    while IFS='=' read -r key value; do
        key=$(echo "$key" | tr -d ' \r\t')
        value=$(echo "$value" | tr -d ' \r\t')

        if [[ "$key" =~ ^\[Profile ]]; then
            if [[ -n "$current_name" && -n "$current_path" ]]; then
                echo "${current_name}:${current_path}"
            fi
            current_name=""
            current_path=""
            is_relative=1
        elif [[ "$key" == "Name" ]]; then
            current_name="$value"
        elif [[ "$key" == "Path" ]]; then
            current_path="$value"
        elif [[ "$key" == "IsRelative" ]]; then
            is_relative="$value"
        fi
    done < "$PROFILES_INI"

    if [[ -n "$current_name" && -n "$current_path" ]]; then
        echo "${current_name}:${current_path}"
    fi
}

# Function: Detect default profile path
get_default_profile_path() {
    # Check Install section default first
    local def_path
    def_path=$(grep -A 5 '^\[Install' "$PROFILES_INI" | grep '^Default=' | head -n 1 | cut -d'=' -f2 | tr -d ' \r\t' || true)

    if [[ -z "$def_path" ]]; then
        # Fallback to Profile with default-release or Profile0
        def_path=$(grep -B 2 -A 4 'Name=default-release' "$PROFILES_INI" | grep '^Path=' | head -n 1 | cut -d'=' -f2 | tr -d ' \r\t' || true)
    fi

    if [[ -z "$def_path" ]]; then
        # Last fallback: first profile
        def_path=$(grep '^Path=' "$PROFILES_INI" | head -n 1 | cut -d'=' -f2 | tr -d ' \r\t' || true)
    fi

    if [[ "$def_path" == /* ]]; then
        echo "$def_path"
    else
        echo "${FIREFOX_DIR}/${def_path}"
    fi
}

# Function: Resolve profile name or path to full directory
resolve_profile_dir() {
    local target="$1"
    if [[ -z "$target" || "$target" == "default" ]]; then
        get_default_profile_path
        return
    fi

    # Check if target is full path
    if [[ -d "$target" ]]; then
        echo "$target"
        return
    fi

    # Check relative to ~/.mozilla/firefox
    if [[ -d "${FIREFOX_DIR}/${target}" ]]; then
        echo "${FIREFOX_DIR}/${target}"
        return
    fi

    # Search by Name
    while IFS=':' read -r name path; do
        if [[ "$name" == "$target" ]]; then
            if [[ "$path" == /* ]]; then
                echo "$path"
            else
                echo "${FIREFOX_DIR}/${path}"
            fi
            return
        fi
    done < <(get_profiles)

    log_err "Profile '$target' could not be found."
    exit 1
}

# Function: Check if Firefox is currently running
is_firefox_running() {
    pgrep -x "firefox" >/dev/null 2>&1 || pgrep -x "firefox-bin" >/dev/null 2>&1
}

# Subcommand: Status
cmd_status() {
    log_header "Firefox Environment & Profile Status"

    if is_firefox_running; then
        echo -e "  Process:          ${C_YELLOW}Firefox is RUNNING (PID $(pgrep -d', ' -x "firefox" || pgrep -d', ' -x "firefox-bin"))${C_RESET}"
    else
        echo -e "  Process:          ${C_GREEN}Firefox is STOPPED${C_RESET}"
    fi

    local ff_ver
    ff_ver=$(firefox --version 2>/dev/null || echo "Unknown")
    echo -e "  Browser Version:  ${C_BOLD}${ff_ver}${C_RESET}"

    local def_dir
    def_dir=$(get_default_profile_path)
    echo -e "  Default Profile:  ${C_CYAN}${def_dir##*/}${C_RESET} (${def_dir})"

    echo -e "\n  ${C_BOLD}Detected Profiles:${C_RESET}"
    while IFS=':' read -r name path; do
        local p_dir
        if [[ "$path" == /* ]]; then p_dir="$path"; else p_dir="${FIREFOX_DIR}/${path}"; fi
        local ujs_status="${C_GRAY}No user.js${C_RESET}"
        if [[ -f "${p_dir}/user.js" ]]; then
            local lines
            lines=$(wc -l < "${p_dir}/user.js")
            ujs_status="${C_GREEN}user.js active (${lines} lines)${C_RESET}"
        fi
        local is_def=""
        if [[ "$p_dir" == "$def_dir" ]]; then
            is_def=" ${C_YELLOW}[Default]${C_RESET}"
        fi
        echo -e "    • ${C_BOLD}${name}${C_RESET}${is_def} -> ${p_dir##*/} (${ujs_status})"
    done < <(get_profiles)

    echo -e "\n  ${C_BOLD}GPU & Hardware Acceleration Diagnostics:${C_RESET}"
    local gpu_info
    gpu_info=$(lspci -k 2>/dev/null | grep -A 2 -E "(VGA|3D)" | head -n 2 | paste -sd " " - || echo "Unknown GPU")
    echo -e "    • GPU Device:     ${gpu_info}"
    if command -v vainfo >/dev/null 2>&1; then
        local va_driver
        va_driver=$(vainfo 2>&1 | grep "Driver version" || echo "Mesa driver active")
        echo -e "    • VA-API Driver:  ${C_GREEN}${va_driver}${C_RESET}"
    else
        echo -e "    • VA-API:         Mesa gallium/radeonsi (vainfo not installed)"
    fi
}

# Subcommand: Apply
cmd_apply() {
    local target="${1:-default}"

    if [[ ! -f "$TEMPLATE_USER_JS" ]]; then
        log_err "Optimized user.js template not found at: ${TEMPLATE_USER_JS}"
        exit 1
    fi

    if [[ "$target" == "all" ]]; then
        log_info "Applying optimizations to ALL Firefox profiles..."
        while IFS=':' read -r name path; do
            local p_dir
            if [[ "$path" == /* ]]; then p_dir="$path"; else p_dir="${FIREFOX_DIR}/${path}"; fi
            apply_to_profile "$p_dir" "$name"
        done < <(get_profiles)
    else
        local p_dir
        p_dir=$(resolve_profile_dir "$target")
        apply_to_profile "$p_dir" "$target"
    fi

    echo ""
    log_ok "Optimization applied successfully!"
    if is_firefox_running; then
        log_warn "Firefox is currently running. Please restart Firefox for all settings to take effect."
    else
        log_info "Start Firefox to enjoy faster page loads, low RAM usage, and GPU acceleration."
    fi
}

apply_to_profile() {
    local p_dir="$1"
    local p_name="$2"

    if [[ ! -d "$p_dir" ]]; then
        log_warn "Directory $p_dir does not exist, skipping."
        return
    fi

    log_info "Configuring profile: ${C_BOLD}${p_name}${C_RESET} (${p_dir##*/})"

    # Backup existing user.js if present
    if [[ -f "${p_dir}/user.js" ]]; then
        local timestamp
        timestamp=$(date +%Y%m%d_%H%M%S)
        local backup_file="${p_dir}/user.js.bak.${timestamp}"
        cp "${p_dir}/user.js" "$backup_file"
        log_info "  Backed up previous user.js -> ${backup_file##*/}"
    fi

    # Copy optimized user.js
    cp "$TEMPLATE_USER_JS" "${p_dir}/user.js"
    log_ok "  Installed optimized user.js (${p_dir##*/}/user.js)"
}

# Subcommand: Vacuum / Clean
cmd_vacuum() {
    local target="${1:-default}"

    if is_firefox_running; then
        log_err "Firefox is currently RUNNING!"
        log_err "Database vacuuming and cleanup requires Firefox to be closed to prevent database lock conflicts."
        echo -e "Please close Firefox completely and re-run: ${C_BOLD}firefox-optimize clean${C_RESET}"
        exit 1
    fi

    if [[ "$target" == "all" ]]; then
        log_info "Cleaning and optimizing databases for ALL profiles..."
        while IFS=':' read -r name path; do
            local p_dir
            if [[ "$path" == /* ]]; then p_dir="$path"; else p_dir="${FIREFOX_DIR}/${path}"; fi
            vacuum_profile "$p_dir" "$name"
        done < <(get_profiles)
    else
        local p_dir
        p_dir=$(resolve_profile_dir "$target")
        vacuum_profile "$p_dir" "$target"
    fi

    log_ok "Database vacuuming & index defragmentation completed."
}

vacuum_profile() {
    local p_dir="$1"
    local p_name="$2"

    log_header "Vacuuming Profile: ${p_name} (${p_dir##*/})"

    local total_before=0
    local total_after=0

    # Clean orphaned WAL / SHM journal files
    rm -f "${p_dir}"/*-wal "${p_dir}"/*-shm

    for db in "${p_dir}"/*.sqlite; do
        [[ -f "$db" ]] || continue
        local fname="${db##*/}"
        local sz_before
        sz_before=$(stat -c%s "$db" 2>/dev/null || echo 0)
        total_before=$((total_before + sz_before))

        sqlite3 "$db" "VACUUM; REINDEX;" 2>/dev/null || true

        local sz_after
        sz_after=$(stat -c%s "$db" 2>/dev/null || echo 0)
        total_after=$((total_after + sz_after))

        local diff=$((sz_before - sz_after))
        if [[ $diff -gt 4096 ]]; then
            local kb_saved=$((diff / 1024))
            echo -e "  • ${fname}: freed ${C_GREEN}${kb_saved} KB${C_RESET}"
        fi
    done

    local mb_before
    local mb_after
    mb_before=$(echo "scale=2; $total_before / 1048576" | bc 2>/dev/null || echo "$((total_before / 1048576))")
    mb_after=$(echo "scale=2; $total_after / 1048576" | bc 2>/dev/null || echo "$((total_after / 1048576))")
    local saved_total=$(( (total_before - total_after) / 1024 ))

    echo -e "  ${C_BOLD}Total Database Footprint:${C_RESET} ${mb_before} MB -> ${C_GREEN}${mb_after} MB${C_RESET} (Saved ${saved_total} KB)"
}

# Subcommand: Restore
cmd_restore() {
    local target="${1:-default}"
    local p_dir
    p_dir=$(resolve_profile_dir "$target")

    log_header "Available Backups in: ${p_dir##*/}"

    local backups=()
    while IFS= read -r f; do
        [[ -f "$f" ]] && backups+=("$f")
    done < <(find "$p_dir" -maxdepth 1 -name "user.js.bak.*" | sort -r)

    if [[ ${#backups[@]} -eq 0 ]]; then
        log_warn "No timestamped user.js backups found in this profile."
        return
    fi

    echo "Select a backup to restore:"
    for i in "${!backups[@]}"; do
        local b_file="${backups[$i]}"
        local b_date
        b_date=$(stat -c%y "$b_file" | cut -d'.' -f1)
        echo -e "  [${C_CYAN}$((i+1))${C_RESET}] ${b_file##*/} (${C_GRAY}${b_date}${C_RESET})"
    done

    echo -n "Enter number (or 'q' to cancel): "
    read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#backups[@]} )); then
        local selected="${backups[$((choice-1))]}"
        cp "$selected" "${p_dir}/user.js"
        log_ok "Restored ${selected##*/} -> user.js"
    else
        log_info "Restore cancelled."
    fi
}

cmd_help() {
    echo -e "${C_BOLD}Firefox Optimizer & Maintenance Utility${C_RESET}
Tuned for Arch Linux / Hyprland (AMD GPU VA-API, Low-RAM, Wayland)

${C_BOLD}USAGE:${C_RESET}
    firefox-optimize <command> [options]

${C_BOLD}COMMANDS:${C_RESET}
    status                 Display Firefox processes, profiles, and hardware decode status
    apply [profile|all]    Apply optimized user.js to default profile (or specified/all)
    clean [profile|all]    Vacuum and defragment SQLite databases (requires Firefox closed)
    restore [profile]      Restore an earlier user.js backup
    help                   Show this help message

${C_BOLD}EXAMPLES:${C_RESET}
    firefox-optimize status
    firefox-optimize apply
    firefox-optimize apply all
    firefox-optimize clean
    firefox-optimize restore"
}

# Interactive Menu
cmd_interactive() {
    clear || true
    echo -e "${C_BOLD}${C_CYAN}============================================${C_RESET}"
    echo -e "${C_BOLD}       Firefox Optimizer for Arch Linux     ${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}============================================${C_RESET}"
    cmd_status

    echo -e "\n${C_BOLD}Choose an action:${C_RESET}"
    echo -e "  [${C_GREEN}1${C_RESET}] Apply optimizations to default profile"
    echo -e "  [${C_GREEN}2${C_RESET}] Apply optimizations to ALL profiles"
    echo -e "  [${C_GREEN}3${C_RESET}] Vacuum & Defragment databases (Fast Startup)"
    echo -e "  [${C_GREEN}4${C_RESET}] Restore previous backup"
    echo -e "  [${C_RED}q${C_RESET}] Exit"
    echo ""
    echo -n "Enter option [1-4, q]: "
    read -r opt

    case "$opt" in
        1) cmd_apply "default" ;;
        2) cmd_apply "all" ;;
        3) cmd_vacuum "default" ;;
        4) cmd_restore "default" ;;
        q|Q) exit 0 ;;
        *) echo "Invalid option"; exit 1 ;;
    esac
}

# Main Dispatch
ACTION="${1:-}"

case "$ACTION" in
    status|--status|-s)
        cmd_status
        ;;
    apply|--apply|-a)
        cmd_apply "${2:-default}"
        ;;
    clean|vacuum|--clean|--vacuum|-c)
        cmd_vacuum "${2:-default}"
        ;;
    restore|--restore|-r)
        cmd_restore "${2:-default}"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    "")
        cmd_interactive
        ;;
    *)
        log_err "Unknown option '$ACTION'"
        cmd_help
        exit 1
        ;;
esac
